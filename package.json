{
  "name": "roscolab",
  "private": true,
  "version": "2.0.0",
  "description": "Roscos de preguntas creados por docentes y estudiantes.",
  "scripts": {
    "css": "node scripts/copy-assets.mjs && tailwindcss -i src/app.css -o public/assets/app.css --minify",
    "db": "wrangler d1 migrations apply roscolab --local",
    "dev": "npm run css && npm run db && wrangler dev",
    "test": "node --test tests/api.test.mjs tests/salas.test.mjs tests/generador.test.mjs",
    "deploy:check": "npm run css && wrangler deploy --dry-run"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.2.5",
    "@fontsource-variable/montserrat": "5.2.5",
    "@fortawesome/fontawesome-free": "6.5.2",
    "tailwindcss": "3.4.17",
    "wrangler": "4.158.0"
  }
}
