{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "roscolab",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "vars": {
    "GEMINI_MODEL": "gemini-3.8-flash",
    "GENERACION_DIARIA": "false",
    "GENERADOR_LIMITE_DIARIO": "20"
  },
  "triggers": { "crons": ["0 8 * * *"] },
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/r/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "roscolab",
      // Se reemplaza por el id real al crear la base con `wrangler d1 create roscolab`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
